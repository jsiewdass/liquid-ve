# =============================================================================
# liquidVE environment configuration
# Copy to `.env` and replace every placeholder before running.
# Never commit the real `.env`. Secret values are never logged by the app.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=liquidVE
# One of: local | staging | production
APP_ENV=local
# Must be false in production (validated at startup).
DEBUG=true
API_V1_PREFIX=/api/v1
# REQUIRED. Generate with: openssl rand -hex 32
# Must be at least 32 characters in production. Never use the placeholder.
SECRET_KEY=replace-with-64-char-random-string
# REQUIRED. Internal service key for the X-API-Key and bearer-token checks.
INTERNAL_API_KEY=change-me

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# REQUIRED in production. SQLite is the local default; PostgreSQL is supported.
# SQLite example:  DATABASE_URL=sqlite+aiosqlite:///./data/liquidve.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://liquidve:change-me@localhost:5432/liquidve
DATABASE_URL=sqlite+aiosqlite:///./data/liquidve.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Binance C2C
# -----------------------------------------------------------------------------
# REQUIRED. Read-only + C2C trading permissions only. Never enable withdrawals.
BINANCE_API_KEY=change-me
BINANCE_API_SECRET=change-me
BINANCE_C2C_BASE_URL=https://p2p.binance.com
# Milliseconds; Binance rejects values above 60000.
BINANCE_RECV_WINDOW_MS=5000
BINANCE_ASSET=USDT
BINANCE_FIAT=VES

# -----------------------------------------------------------------------------
# Cachicamo Cash
# -----------------------------------------------------------------------------
# REQUIRED. Must use https for public hosts; http is allowed for local or
# Tailscale (100.64.0.0/10) hosts only.
CACHICAMO_BASE_URL=https://api.cachicamo.example.com
CACHICAMO_API_KEY=change-me
# REQUIRED. Generate with: openssl rand -hex 32
# Must be at least 32 characters in production.
CACHICAMO_WEBHOOK_SECRET=replace-with-64-char-random-string
# Maximum accepted timestamp skew, in seconds, for webhook signatures.
CACHICAMO_WEBHOOK_TOLERANCE_SECONDS=300
CACHICAMO_SIGNATURE_HEADER=X-Cachicamo-Signature
CACHICAMO_TIMESTAMP_HEADER=X-Cachicamo-Timestamp
CACHICAMO_EVENT_ID_HEADER=X-Cachicamo-Event-Id

# -----------------------------------------------------------------------------
# Android SMS gateway (Tailscale)
# -----------------------------------------------------------------------------
# REQUIRED. http is accepted only for private, loopback or Tailscale hosts.
# Replace 100.64.0.10 with the Tailscale IP assigned to the Android device.
SMS_GATEWAY_BASE_URL=http://100.64.0.10:8080
SMS_GATEWAY_TOKEN=change-me
SMS_GATEWAY_TIMEOUT_SECONDS=10
SMS_GATEWAY_POLL_INTERVAL_SECONDS=15
# Keep disabled unless the gateway inbox should be polled in the background.
SMS_POLLER_ENABLED=false
# Optional HMAC secret shared with the gateway, if it signs its callbacks.
SMS_GATEWAY_SHARED_SECRET=

# -----------------------------------------------------------------------------
# Outbound HTTP policy
# -----------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5
# Total attempts including the first call. Non-idempotent calls never retry.
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=8

# -----------------------------------------------------------------------------
# Risk limits (VES amounts use 2 decimals, USDT uses up to 8)
# -----------------------------------------------------------------------------
# REQUIRED.
MAX_TX_AMOUNT_VES=5000.00
MIN_TX_AMOUNT_VES=1.00
DAILY_LIMIT_VES=20000.00
# REQUIRED.
MAX_USDT_PER_ORDER=1000.00000000
MANUAL_REVIEW_ON_LIMIT=true

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# JSON output is recommended in production; false gives colored console logs.
LOG_JSON=true

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Comma-separated list. Empty means no cross-origin browser access.
CORS_ORIGINS=
# Comma-separated list of accepted Host headers. "*" disables the check.
ALLOWED_HOSTS=*
# Comma-separated list of proxy CIDRs trusted for X-Forwarded-* headers.
TRUSTED_PROXIES=

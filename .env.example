# =============================================================================
# liquidVE environment configuration
# Copy to `.env` and replace every placeholder before running.
# Never commit the real `.env`. Secret values are never logged by the app.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=liquidVE
# One of: local | staging | production
APP_ENV=local
# Must be false in production (validated at startup).
DEBUG=true
API_V1_PREFIX=/api/v1
# REQUIRED. Generate with: openssl rand -hex 32
# Must be at least 32 characters in production. Never use the placeholder.
SECRET_KEY=replace-with-64-char-random-string
# REQUIRED. Internal service key for the X-API-Key and bearer-token checks.
INTERNAL_API_KEY=change-me

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# REQUIRED in production. SQLite is the local default; PostgreSQL is supported.
# SQLite example:  DATABASE_URL=sqlite+aiosqlite:///./data/liquidve.db
# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://liquidve:change-me@localhost:5432/liquidve
DATABASE_URL=sqlite+aiosqlite:///./data/liquidve.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Binance C2C
# -----------------------------------------------------------------------------
# REQUIRED. Read-only + C2C trading permissions only. Never enable withdrawals.
BINANCE_API_KEY=change-me
BINANCE_API_SECRET=change-me
BINANCE_C2C_BASE_URL=https://p2p.binance.com
# Milliseconds; Binance rejects values above 60000.
BINANCE_RECV_WINDOW_MS=5000
BINANCE_ASSET=USDT
BINANCE_FIAT=VES

# -----------------------------------------------------------------------------
# Cachicamo Cash
# -----------------------------------------------------------------------------
# REQUIRED. Must use https for public hosts; http is allowed for local or
# Tailscale (100.64.0.0/10) hosts only.
CACHICAMO_BASE_URL=https://api.cachicamo.example.com
CACHICAMO_API_KEY=change-me
# REQUIRED. Generate with: openssl rand -hex 32
# Must be at least 32 characters in production.
CACHICAMO_WEBHOOK_SECRET=replace-with-64-char-random-string
# Maximum accepted timestamp skew, in seconds, for webhook signatures.
CACHICAMO_WEBHOOK_TOLERANCE_SECONDS=300
CACHICAMO_SIGNATURE_HEADER=X-Cachicamo-Signature
CACHICAMO_TIMESTAMP_HEADER=X-Cachicamo-Timestamp
CACHICAMO_EVENT_ID_HEADER=X-Cachicamo-Event-Id

# -----------------------------------------------------------------------------
# Outbound HTTP policy
# -----------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5
# Total attempts including the first call. Non-idempotent calls never retry.
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=8

# -----------------------------------------------------------------------------
# Risk limits (VES amounts use 2 decimals, USDT uses up to 8)
# -----------------------------------------------------------------------------
# REQUIRED.
MAX_TX_AMOUNT_VES=5000.00
MIN_TX_AMOUNT_VES=1.00
DAILY_LIMIT_VES=20000.00
# REQUIRED.
MAX_USDT_PER_ORDER=1000.00000000
MANUAL_REVIEW_ON_LIMIT=true

# -----------------------------------------------------------------------------
# Buy flow (Pago Móvil) and caps
# -----------------------------------------------------------------------------
# REQUIRED. Per-order VES cap; the process refuses to boot without it.
MAX_BUY_AMOUNT_VES=5000.00
# REQUIRED. UTC-day outgoing payment cap. Must be >= MAX_BUY_AMOUNT_VES.
DAILY_PAY_LIMIT_VES=20000.00
# Maximum allowed deviation between the implied and quoted rate, in percent.
# Must be greater than 0 and at most 100.
RATE_TOLERANCE_PCT=1.0
# -----------------------------------------------------------------------------
# Binance P2P browser (BUY order detail scraping and close)
# -----------------------------------------------------------------------------
# Keep false until a valid Playwright storage-state file exists. When false the
# browser adapter is never constructed and the operator cannot start a purchase payment.
BINANCE_BROWSER_ENABLED=false
# Run Chromium without a window. Only relevant when the browser is enabled.
BINANCE_BROWSER_HEADLESS=true
# Per-navigation timeout in milliseconds.
BINANCE_BROWSER_TIMEOUT_MS=20000
# Playwright storage-state (cookies) exported once by hand; gitignored and never
# committed. Missing or expired state fails with `binance_session_expired`.
BINANCE_SESSION_STATE_PATH=./data/binance_state.json
# Order-detail page template; {order_number} is substituted per order.
BINANCE_P2P_ORDER_URL_TEMPLATE=https://p2p.binance.com/en/order/{order_number}

# -----------------------------------------------------------------------------
# BUY detection worker (polls Binance C2C history)
# -----------------------------------------------------------------------------
# Optional order detection. Starting a payment always requires the operator endpoint.
BUY_WORKER_ENABLED=false
# Seconds between detection ticks.
BUY_WORKER_POLL_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# Banesco Online payment rail (BUY), Telegram handoff, receipts and release
# -----------------------------------------------------------------------------
# Master kill switch. When false no Banesco session is ever started. All secrets
# below are required only when this switch is enabled.
BANESCO_RAIL_ENABLED=false
# Absolute https login page. Replace the placeholder before enabling the rail.
BANESCO_ONLINE_LOGIN_URL=https://www.banesconline.com/Mantis/WebSite/Login.aspx
# Required when BANESCO_RAIL_ENABLED=true. Never commit a real value.
BANESCO_ONLINE_USER=replace-with-banesco-user
BANESCO_ONLINE_PASSWORD=replace-with-banesco-password
# Security answers keyed by question. Required when the rail is enabled.
BANESCO_SECURITY_ANSWER_HOBBIE=replace-with-answer
BANESCO_SECURITY_ANSWER_CHILDHOOD_HERO=replace-with-answer
BANESCO_SECURITY_ANSWER_FAVOURITE_DESSERT=replace-with-answer
BANESCO_SECURITY_ANSWER_COUNTRY_TO_VISIT=replace-with-answer
BANESCO_BROWSER_HEADLESS=true
BANESCO_BROWSER_TIMEOUT_MS=30000
BANESCO_MAX_CONCURRENT_PAYMENTS=1
BANESCO_CLAVE_RETRY_LIMIT=0
BANESCO_PAYMENT_CONCEPT=Pago
# Empty fails closed. Accepts only "" or one of V, E, J, G, R.
BANESCO_DEFAULT_ID_TYPE=

# Telegram Bot API operator handoff. Required when the rail or Telegram is on.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_OPERATOR_CHAT_ID=0
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Time to enter the code after opening the form.
TELEGRAM_CLAVE_TIMEOUT_SECONDS=30
# Time to open the authorization link after it is created.
OPERATOR_LINK_TIMEOUT_SECONDS=300
# HTTPS origin reachable from the operator's phone, with no path.
OPERATOR_PUBLIC_URL=https://operator.example

# Receipt evidence is stored outside the database; the directory is gitignored.
RECEIPT_STORAGE_DIR=./data/receipts
RECEIPT_RETENTION_DAYS=30

# Release watcher and at-most-once automatic appeal.
RELEASE_WATCHER_ENABLED=false
RELEASE_POLL_INTERVAL_SECONDS=30
RELEASE_TIMEOUT_SECONDS=900
# One of: auto | alert | off.
RELEASE_APPEAL_MODE=auto
BUY_PAYMENT_RAIL=banesco

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# JSON output is recommended in production; false gives colored console logs.
LOG_JSON=true

# -----------------------------------------------------------------------------
# HTTP server
# -----------------------------------------------------------------------------
# Comma-separated list. Empty means no cross-origin browser access.
CORS_ORIGINS=
# Comma-separated list of accepted Host headers. "*" disables the check.
ALLOWED_HOSTS=*
# Comma-separated list of proxy CIDRs trusted for X-Forwarded-* headers.
TRUSTED_PROXIES=
